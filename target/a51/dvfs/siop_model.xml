<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE siop_document [
<!ELEMENT siop_document (temperatures, levels, components, scenarios?)>
<!ELEMENT temperatures (temp+)>
<!ELEMENT temp EMPTY>
<!ATTLIST temp
          type (AP|BAT|USB|CHG|PA|WIFI) #REQUIRED
          default CDATA "1"
          min CDATA "1"
          max CDATA "1"
          step CDATA "1"
          init CDATA "5"
          hold CDATA "1"
          gap CDATA "0">
<!ELEMENT levels (level+)>
<!ELEMENT level EMPTY>
<!ATTLIST level
          id CDATA #REQUIRED
          temp CDATA #REQUIRED>
<!ELEMENT components (component+)>
<!ELEMENT component (limiter+)>
<!ATTLIST component
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED>
<!ELEMENT scenarios (scenario*, scenario_group*)>
<!ELEMENT scenario (limiter+)>
<!-- you can use below delimiter on scenario name -->
<!-- "!" : intent, ":" : package, "," : plural    -->
<!ATTLIST scenario
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED
          priority CDATA "0">
<!ELEMENT scenario_group (scenario+)>
<!ELEMENT scenario EMPTY>
<!ATTLIST scenario
          name CDATA #REQUIRED
          limiter CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
<!ELEMENT limiter EMPTY>
<!ATTLIST limiter
          name CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
]>

<siop_document>

    <overheatcontrol>
        <complex>
            <MW  formula="AP*BAT" temp="540.390" />
            <LTB formula="AP*BAT" temp="540.390" />
            <GDM formula="AP*BAT" temp="490.410" />
            <GDMLTB formula="AP*BAT" temp="510.430"/>
            <SS  formula="AP*BAT" temp="760.480" />
        </complex>
    </overheatcontrol>

    <modelsettings>
        <sensors>
            <LTB_SENSOR type="PALM" />
        </sensors>
    </modelsettings>

    <components>

        <component name="AP" tempType="LRP" >
            <limiter name="CPUFreqMax" step="0" temp="360:380" value="-1:1664000" />
            <limiter name="GPUFreqMax" step="0" temp="360:380" value="-1:683000"  />
            <limiter name="AppInstallDelay" value="5000" />
            <limiter name="BackgroundCpuset" temp="360" gap="20" value="-1:100:200:300" />
        </component>

        <component name="CHG" tempType="LRP">
            <limiter name="Charging" value="-1" />
        </component>

        <component name="DISPLAY" tempType="LRP">
            <limiter name="Brightness" temp="390" value="-1:199:142" />
        </component>

        <component name="WIFI" tempType="LRP">
            <limiter name="SmartBonding" temp="420" value="-1:1" />
        </component>

        <component name="AP+DISPLAY" tempType="LRP" >
            <limiter name="AppInstallDelay" value="-1" />
        </component>

        <component name="CHG+DISPLAY" tempType="LRP*BAT">
            <limiter name="Charging" temp="0.280:300.300:370.300:390.300" value="-1:70:70:10" />
        </component>

    </components>

    <scenarios>

        <scenario name="ScreenOffInCall" tempType="SKIN" priority="1" >
            <limiter name="Charging" value="70" />
        </scenario>

        <scenario name="ScreenOff" tempType="LRP" priority="1" >
            <limiter name="Charging" value="100" />
        </scenario>

        <scenario name="ScreenOffInCall" tempType="LRP" priority="1">
            <limiter name="Charging" value="70" />
        </scenario>

        <scenario name="TPBoost:com.FTATS" tempType="LRP" >
            <limiter name="CPUFreqMax" value="-1" />
        </scenario>

        <scenario name="Heavyuser" tempType="LRP" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="460" value="-1:1664000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="460" value="-1:683000"  />
        </scenario>

        <scenario name="SIPStart" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1664000:1508000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:683000" />
        </scenario>

        <scenario name="AppStart" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1664000:1508000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:683000" />
        </scenario>

        <scenario name="Badge" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1664000:1508000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:683000" />
        </scenario>

        <scenario name="WakeUp" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1664000:1508000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:683000" />
        </scenario>

        <scenario name="AppStore" tempType="LRP" >
            <limiter name="Charging" value="20" />
            <limiter name="AppInstallDelay" temp="300" value="-1:3000:5000" />
        </scenario>

        <scenario name="Dex2OatLimit" tempType="LRP" priority="1" >
            <limiter name="CPUFreqMax" temp="320:350" value="-1:1664000" />
        </scenario>

        <scenario name="VtCallControl" tempType="LRP" priority="1">
            <limiter name="AppInstallDelay" temp="300"     value="-1:3000:5000" />
            <limiter name="CPUFreqMax"      temp="330:350" value="-1:1248000"   />
            <limiter name="Brightness"      temp="410:430" value="199:142"      />
            <limiter name="Charging"                       value="20"           />
            <limiter name="CameraFps"       temp="360"     value="-1:1"         />
        </scenario>

        <scenario name="Navigation" tempType="LRP" >
            <limiter name="Brightness" temp="520" value="166" />
            <limiter name="Charging"               value="70" />
        </scenario>

        <scenario name="SecurePlaybackSmartView!SecureSmartView" tempType="LRP" priority="1">
            <limiter name="Charging"   value="70" />
        </scenario>

        <scenario name="CameraRecording!Camera_recording,Camera_recordingDual" tempType="LRP" priority="1" >
            <limiter name="Brightness" temp="410" value="199:142" />
            <limiter name="Charging" value="20" />
        </scenario>

        <scenario name="CameraSlowMotion!Camera_ssm,Camera_sm" tempType="LRP" priority="1" >
            <limiter name="CPUFreqMax" value="-1" />
        </scenario>

        <scenario_group name="GameThermalCpuControl" tempType="LRP" >
            <scenario id="-3"  limiter="CPUFreqMax" step="0" temp="380:390:410" value="-1:1898000:1456000" />
            <scenario id="-2"  limiter="CPUFreqMax" step="0" temp="380:390:410" value="-1:1898000:1508000" />
            <scenario id="-1"  limiter="CPUFreqMax" step="0" temp="380:390:410" value="-1:1898000:1664000" />
            <scenario id="0"   limiter="CPUFreqMax" step="0" temp="380:390:410" value="-1:1898000:1768000" />
            <scenario id="1"   limiter="CPUFreqMax" step="0" temp="380:390:410" value="-1:1898000:1898000" />
            <scenario id="2"   limiter="CPUFreqMax" step="0" temp="380:390:410" value="-1:2080000:1976000" />
            <scenario id="3"   limiter="CPUFreqMax" step="0" temp="380:390:410" value="-1:2080000:2080000" />
            <scenario id="4"   limiter="CPUFreqMax"                             value="-1"                 />
            <scenario name="BackgroundCpuset" temp="380:400:420" value="100:200:300" />
        </scenario_group>

        <scenario_group name="GameThermalGpuControl" tempType="LRP" >
            <scenario id="-3" limiter="GPUFreqMax" step="0" temp="380:390:410" value="-1:839000:546000" />
            <scenario id="-2" limiter="GPUFreqMax" step="0" temp="380:390:410" value="-1:839000:546000" />
            <scenario id="-1" limiter="GPUFreqMax" step="0" temp="380:390:410" value="-1:839000:572000" />
            <scenario id="0"  limiter="GPUFreqMax" step="0" temp="380:390:410" value="-1:839000:683000" />
            <scenario id="1"  limiter="GPUFreqMax" step="0" temp="380:410"     value="-1:764000"        />
            <scenario id="2"  limiter="GPUFreqMax" step="0" temp="380:410"     value="-1:839000"        />
            <scenario id="3"  limiter="GPUFreqMax"                             value="-1"               />
            <scenario         limiter="Charging"                               value="70" />
        </scenario_group>

    </scenarios>

</siop_document>